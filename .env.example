# Порядок фолбэка. "mock" в конце = демо не упадёт никогда.
AI_PROVIDERS=anthropic,openai,mock
# true -> только заготовленные ответы, без сети (страховка на сцене)
DEMO_MODE=false
FIRST_TOKEN_TIMEOUT=8

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Любой OpenAI-совместимый API. Для Ollama: OPENAI_BASE_URL=http://localhost:11434/v1, OPENAI_API_KEY=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:5173
